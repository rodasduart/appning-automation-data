{                                                                                                                                                                                                                                 
"packageName": "de.ard.sportschau.auto",
"screens": {                                                                                                                                                                                                                    
    "icon_menu_screen": {
    "strategy": "KEEP_ONLY",
    "selectors": [                                                                                                                                                                                                              
        { "type": "containerIdWithText", "value": "com.android.car.carlauncher:id/app_item", "childText": "Sportschau" }
    ] 
        },
    "home_screen": {                                                                                                                                                                                                              
        "strategy": "MASK_DYNAMIC",                                                                                                                                                                                                 
        "selectors": [                                                                                                                                                                                                              
          { "type": "id", "value": "com.android.car.media:id/media_item_click_target" },
          { "type": "id", "value": "com.android.car.media:id/item_container" },                                                                                                                                                     
          { "type": "id", "value": "com.android.car.media:id/thumbnail" },                                                                                                                                                          
          { "type": "id", "value": "com.android.car.media:id/title" },                                                                                                                                                              
          { "type": "id", "value": "com.android.car.media:id/subtitle" },                                                                                                                                                           
          { "type": "id", "value": "com.android.car.media:id/linear_progress_bar" },
          { "type": "id", "value": "com.android.car.media:id/minimized_control_bar" },
          { "type": "id", "value": "com.android.car.media:id/car_ui_scrollbar_page_up"},
          { "type": "id", "value": "com.android.car.media:id/car_ui_scrollbar_page_down" },
          { "type": "id", "value": "com.android.car.media:id/car_ui_scrollbar_thumb" },
          { "type": "id", "value": "com.android.car.media:id/car_ui_scrollbar_track" }                                                                                                                                               
        ]                                                                                                                                                                                                                           
      },
      "like_screen": {
        "strategy": "KEEP_ONLY",                                                                                                                                                                                                    
        "selectors": [                                      
          { "type": "id", "value": "com.android.car.media:id/playback_controls" }                                                                                                                                                   
        ]                                                                                                                                                                                                                           
      },                                                    
      "unlike_screen": {                                                                                                                                                                                                            
        "strategy": "KEEP_ONLY",
        "selectors": [
          { "type": "id", "value": "com.android.car.media:id/playback_controls" }
        ]                                                                                                                                                                                                                           
      }  
    }
}